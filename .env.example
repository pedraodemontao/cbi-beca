# Central CBI — variáveis de ambiente
#
# Copie para `.env.local` e preencha. NUNCA comite valor real: o `.gitignore`
# barra todo `.env*` e abre exceção só para este arquivo de exemplo.
#
# Em produção, cada uma precisa ser criada também na Vercel:
#   vercel env add NOME production

# ─── Supabase ───
# A anon key é pública por design — quem protege é a RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: ignora RLS. Só server-side, só nos crons e nos scripts de
# acesso. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Dados de mercado ───
# brapi: catálogo e cotação da B3. Plano gratuito.
BRAPI_TOKEN=

# bolsai: fundamentos da CVM, dividendos e screener de FII. Plano Pro.
BOLSAI_API_KEY=

# CoinGecko: preço de cripto em BRL. OPCIONAL — sem chave funciona, com o
# limite público de ~4 requisições por minuto. A chave demo é gratuita e sobe
# para 30/min.
COINGECKO_API_KEY=

# ─── Anthropic ───
# Chat da assistente.
ANTHROPIC_API_KEY=

# ─── Crons ───
# Protege as rotas /api/cron/*. Em produção a checagem falha FECHADA: sem esta
# variável as rotas recusam. Em desenvolvimento elas ficam abertas.
CRON_SECRET=
